# MongoDB Atlas connection string. Atlas clusters support the transactions used by checkout.
DATABASE_URL="mongodb+srv://seyora-user:replace-me@cluster0.example.mongodb.net/seyora?retryWrites=true&w=majority"

# PostgreSQL connection string used only by the one-time data migration command.
POSTGRES_SOURCE_URL="postgresql://user:password@localhost:5432/seyora?schema=public"

# After replacing both example URLs, run `npm run db:sync` and then `npm run db:migrate:data`.
# The migration copies PostgreSQL records into MongoDB and does not modify the source database.
SESSION_SECRET="generate-a-random-value-with-at-least-32-characters"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
RESEND_API_KEY=""
EMAIL_FROM="Seyora Studio <hello@example.com>"
